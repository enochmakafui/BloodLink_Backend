SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# SQLite for development; for PostgreSQL use e.g. postgresql://user:pass@localhost:5432/bloodlink
DATABASE_URL=sqlite:///bloodlink.db
# Supabase (Session pooler, IPv4). Placeholder only - set the real value in the Render dashboard:
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Only for scripts/migrate_data.sh (set in your shell, never commit real values)
# OLD_DATABASE_URL=postgresql://<render-external-url>
# NEW_DATABASE_URL=postgresql://<supabase-session-pooler-url>
# Frontend origin(s) allowed by CORS (comma-separated not supported; use * or one origin)
CORS_ORIGINS=*

# Used by seed.py
ADMIN_EMAIL=admin@bloodlink.local
ADMIN_PASSWORD=change-this-password
